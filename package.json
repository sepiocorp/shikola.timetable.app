{
  "name": "shikola-timetable-creator",
  "version": "1.0.5",
  "codename": "Monster",
  "description": "Offline timetable creator for schools - by Sepio Corp",
  "author": "Sepio Corp",
  "license": "SEE LICENSE IN LICENSE",
  "copyright": "Copyright © 2026 Sepio Corp. All rights reserved.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=true electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "vite build && electron-builder",
    "publish-release": "node scripts/publish-release.js",
    "publish": "npm run dist && node scripts/publish-release.js --upload"
  },
  "build": {
    "appId": "com.sepiocorp.shikola-timetable",
    "productName": "Shikola Timetable Creator",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "legalTrademarks": "Sepio Corp",
      "publisherName": "Sepio Corp"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "installerLanguages": [
        "en_US"
      ],
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shikola Timetable Creator",
      "runAfterFinish": true,
      "allowElevation": true
    },
    "publish": {
      "provider": "github",
      "owner": "sepiocorp",
      "repo": "shikola.timetable.app"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.3",
    "wait-on": "^7.2.0"
  }
}
